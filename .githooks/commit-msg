#!/usr/bin/env bash
# Reject a commit message that breaks the rules in commits-and-prs.
#
# Enable it once per checkout:
#
#   git config core.hooksPath .githooks
#
# CI runs the same checker over a pull request's commits, so a checkout without
# the hook is caught later rather than never.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
git_dir=$(git rev-parse --git-dir)

# Git runs this hook for merges and reverts too, and writes those messages
# itself: "Merge branch 'x' into edge" has no type prefix and would be rejected,
# leaving --no-verify as the only way through, which also skips the check for
# the next message an author actually writes.
for generated in MERGE_HEAD REVERT_HEAD CHERRY_PICK_HEAD; do
  if [ -e "$git_dir/$generated" ]; then
    exit 0
  fi
done

exec "$root/.claude/scripts/check-commit-message.py" "$1"
