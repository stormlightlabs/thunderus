---
import Eyebrow from "./Eyebrow.astro";
import LandingButton from "./LandingButton.astro";
import TerminalPreview from "./TerminalPreview.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__copy">
    <Eyebrow label="Your minimal pair programmer" />
    <h1 id="hero-title">Stay in the loop.</h1>
    <p class="hero__lede">
      thndrs loads the <code>AGENTS.md</code> guidance and skills that apply to your task, then gives your chosen model visible,
      bounded tools. Requests go straight to the provider. Session data stays on your device, ready to inspect or resume.
    </p>
    <div class="hero__controls">
      <div class="hero__actions">
        <LandingButton href="/docs/getting-started/installation/" variant="primary" icon="arrow">
          Install thndrs
        </LandingButton>
        <LandingButton href="/docs/">Read the docs</LandingButton>
      </div>
      <div class="install" aria-label="Install command">
        <span aria-hidden="true">$</span>
        <code>cargo install --locked thndrs</code>
        <button
          class="install__copy"
          type="button"
          data-copy="cargo install --locked thndrs"
          aria-label="Copy install command">
          <span class="install__copy-icon i-bi-copy" aria-hidden="true"></span>
          <span class="install__check-icon i-bi-check-lg" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>
  <TerminalPreview />
</section>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy]");

  copyButton?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(copyButton.dataset.copy ?? "");
      copyButton.dataset.copied = "true";
      copyButton.setAttribute("aria-label", "Install command copied");
      window.setTimeout(() => {
        delete copyButton.dataset.copied;
        copyButton.setAttribute("aria-label", "Copy install command");
      }, 1800);
    } catch {
      copyButton.setAttribute("aria-label", "Could not copy install command");
    }
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(34rem, 1.18fr);
    gap: clamp(4rem, 6vw, 6rem);
    align-items: center;
    width: min(var(--thndrs-content-width), calc(100% - 3rem));
    min-height: calc(100svh - 5.25rem);
    margin-inline: auto;
    margin-block: 0;
    padding-block: clamp(4rem, 9vw, 6rem) clamp(5rem, 11vw, 7rem);
  }

  .hero__copy {
    position: relative;
    z-index: 1;
  }

  .hero h1 {
    max-width: 10ch;
    margin: 1.5rem 0 0;
    color: var(--thndrs-fg);
    font-family: var(--thndrs-font-serif);
    font-size: clamp(3.5rem, 6.4vw, 6rem);
    font-weight: 470;
    letter-spacing: -0.065em;
    line-height: 0.97;
    text-wrap: balance;
  }

  .hero__lede {
    max-width: 38rem;
    margin: 2rem 0 0;
    color: var(--thndrs-fg-muted);
    font-size: clamp(1rem, 1.5vw, 1.16rem);
    line-height: 1.68;
    text-wrap: pretty;
  }

  .hero__controls {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hero__actions {
    display: flex;
    flex: 0 0 auto;
    gap: 0.75rem;
  }

  .install {
    display: flex;
    flex: none;
    align-items: center;
    width: fit-content;
    min-height: 3rem;
    padding-left: 0.9375rem;
    border: 1px solid var(--thndrs-border);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--thndrs-bg-dark) 58%, transparent);
    color: var(--thndrs-comment);
    font-family: var(--thndrs-font-mono);
    font-size: 0.78rem;
  }

  .install code {
    margin-left: 0.625rem;
    color: var(--thndrs-fg-muted);
    font-family: inherit;
  }

  .install__copy {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: 0.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--thndrs-comment);
    cursor: pointer;
  }

  .install__copy:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid var(--thndrs-cyan);
    outline-offset: -2px;
  }

  .install__copy-icon,
  .install__check-icon {
    grid-area: 1 / 1;
    place-self: center;
    width: 1.0625rem;
    height: 1.0625rem;
    transition:
      opacity 300ms cubic-bezier(0.2, 0, 0, 1),
      filter 300ms cubic-bezier(0.2, 0, 0, 1),
      scale 300ms cubic-bezier(0.2, 0, 0, 1);
  }

  .install__check-icon,
  .install__copy[data-copied="true"] .install__copy-icon {
    scale: 0.25;
    opacity: 0;
    filter: blur(4px);
  }

  .install__copy[data-copied="true"] {
    color: var(--thndrs-green);
  }

  .install__copy[data-copied="true"] .install__check-icon {
    scale: 1;
    opacity: 1;
    filter: blur(0);
  }

  @media (max-width: 68rem) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero__copy {
      max-width: 48rem;
    }

    .hero h1 {
      max-width: 12ch;
    }

  }

  @media (max-width: 40rem) {
    .hero {
      width: calc(100% - 1.75rem);
      gap: 4.5rem;
      padding-block: 4.5rem 6rem;
    }

    .hero h1 {
      font-size: clamp(3rem, 14vw, 4.25rem);
    }

    .hero__actions {
      flex-wrap: nowrap;
    }

    .hero__actions :global(.button) {
      min-width: 0;
      padding-inline: clamp(0.625rem, 3vw, 1.25rem);
      font-size: clamp(0.82rem, 3.7vw, 0.92rem);
      white-space: nowrap;
    }

    .install {
      font-size: 0.7rem;
    }

    .install code {
      flex: 1;
      min-width: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .install__copy-icon,
    .install__check-icon {
      transition-duration: 0.01ms;
    }
  }
</style>
