{
  "name": "thndrs-workspace",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "docs",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd docs build",
    "test": "bun run --cwd packages/lndrs test",
    "check": "bun run --cwd packages/lndrs check"
  },
  "trustedDependencies": [
    "@opentui/core",
    "esbuild",
    "sharp",
    "workerd"
  ]
}
