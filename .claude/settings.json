{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 1200
          }
        ],
        "matcher": "startup"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo fetch:*)",
      "Bash(cargo package:*)",
      "Bash(cargo insta:*)",
      "Bash(pnpm --dir docs install:*)",
      "Bash(pnpm --dir docs build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -vv)",
      "Bash(git worktree list:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git branch -m:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree prune)",
      "Bash(.claude/scripts/push-verified.sh:*)",
      "Bash(rg:*)",
      "Bash(.claude/scripts/ulid.py:*)",
      "Bash(.claude/scripts/check-commit-message.py:*)",
      "Bash(.claude/scripts/tui-capture.sh:*)",
      "Bash(tmux new-session:*)",
      "Bash(tmux send-keys:*)",
      "Bash(tmux capture-pane:*)",
      "Bash(tmux kill-session:*)",
      "Bash(tmux list-panes:*)",
      "Bash(tmux resize-window:*)",
      "Bash(freeze:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)"
    ]
  }
}
