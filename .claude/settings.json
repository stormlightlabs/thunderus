{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ],
        "matcher": "startup"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo fetch:*)",
      "Bash(cargo package:*)",
      "Bash(cargo insta:*)",
      "Bash(pnpm --dir docs install:*)",
      "Bash(pnpm --dir docs build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -vv)",
      "Bash(git worktree list:*)",
      "Bash(rg:*)",
      "Bash(.claude/scripts/ulid.py:*)",
      "Bash(.claude/scripts/check-commit-message.py:*)"
    ]
  }
}
