      "type": "object"
    },
    "name": "create_file"
  },
  {
    "description": "replace_range\n\nReplace a unique exact string occurrence in an existing file.\n\nUse this when you need to edit part of a file. Provide the exact old_string to\nfind and the new_string to replace it with. Fails if old_string appears zero or\nmultiple times, ensuring unambiguous edits. Paths are contained to the workspace\nroot; escapes are rejected. Failed edits leave the file unchanged.",
    "input_schema": {
      "properties": {
        "new_string": {
          "description": "The replacement string.",
