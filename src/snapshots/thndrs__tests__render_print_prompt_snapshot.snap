        "old_string",
        "new_string"
      ],
      "type": "object"
    },
    "name": "replace_range"
  },
  {
    "description": "write_patch\n\nApply a structured patch to create, replace, or edit a file.\n\nUse this as the unified entry point for file writes. Set op to create (new file,\nfails if exists), replace (overwrite full content), or edit (replace a unique exact\nstring). Paths are contained to the workspace root; escapes are rejected. Failed\npatches leave the file unchanged.",
